# ─── AI ────────────────────────────────────────────────────────────────────
# A válaszgenerálás az Anthropic API-t használja (lib/reply-engine.ts).
# Illeszd be a kulcsot az egyenlőségjel után:
ANTHROPIC_API_KEY=sk-ant-...

# Csak akkor kell, ha a kulcs NEM workspace-hez kötött (szervezeti szintű).
# A Console-ban a workspace URL-jében találod.
# ANTHROPIC_WORKSPACE_ID=

# Opcionális. Alapértelmezés: claude-sonnet-4-6
# Ha modellt váltasz, a költségbecslés árait is frissítsd a reply-engine.ts-ben.
# ANTHROPIC_MODEL=claude-opus-5

# ─── Instagram (Meta app) ─────────────────────────────────────────────────
# Saját kitalált jelszó. UGYANEZT kell beírni a Meta dashboard webhook
# beállításánál a "Verify token" mezőbe.
IG_VERIFY_TOKEN=

# Meta App Dashboard → App settings → Basic → App secret.
# Ezzel ellenőrizzük az X-Hub-Signature-256 fejlécet.
IG_APP_SECRET=

# Instagram → API setup with Instagram login → Generate access token.
# Hosszú életű (60 napos) token, lejárat előtt meg kell újítani.
#
# Jogosultságok: instagram_business_basic + instagram_business_manage_messages,
# és a komment-figyeléshez instagram_business_manage_comments is kell.
# Webhook-mezők, amikre fel kell iratkozni: messages ÉS comments.
IG_ACCESS_TOKEN=

# ─── Ügyfél-konfiguráció ──────────────────────────────────────────────────
# Az /onboarding varázsló exportált JSON-ja EGY SORBAN. Ha ez be van állítva,
# ezt használjuk a config/client.json helyett — így új ügyfélhez elég egy új
# Vercel projekt, a repóhoz nem kell hozzányúlni.
# Egy sorba tömörítés:  jq -c . nora-config.json | pbcopy
# Üresen hagyva a config/client.json-ból olvasunk (helyi fejlesztéshez kényelmesebb).
# NORA_CONFIG={"alapok":{...},"ajanlat":{...}}

# Annak az Instagram fióknak a webhook-azonosítója, amelyikhez az IG_ACCESS_TOKEN
# tartozik. Egy Meta apphoz több fiók is köthető, és akkor mindegyik üzenete erre
# a webhookra jön — a többi fiókra hiába generálnánk választ, a küldés elhasal,
# az AI-hívást viszont kifizetnénk.
# Az értéket az /admin figyelmeztető sávja mutatja meg, ha több fiók érkezik.
# Üresen hagyva minden fiók üzenetét feldolgozzuk (egy fióknál ez a helyes).
# IG_ACCOUNT_ID=

# ─── Tárolás (Upstash Redis) ──────────────────────────────────────────────
# console.upstash.com → Create database → REST API fül.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Admin felület ────────────────────────────────────────────────────────
# Két szerepkör, két jelszó. A belépés a /belepes oldalon történik, a munkamenet
# sütiben él 30 napig, és a felület jobb felső sarkában van kijelentkezés.
#
# TULAJDONOS (te): minden, plusz AI-költség, technikai hibák, globális
# vészkapcsoló, /onboarding és /simulator.
# Ha üres, a felület zárva marad.
ADMIN_PASSWORD=

# ÜGYFÉL (a kreátor): saját beszélgetések, kapcsolók, statisztika, beállítások
# és komment-szabályok — költségadat és technikai hiba nélkül.
# Üresen hagyva csak te tudsz belépni.
CLIENT_PASSWORD=

# ─── Korlátok ─────────────────────────────────────────────────────────────
# Beszélgetésenkénti napi maximum válaszszám. Alapértelmezés: 20
# MAX_REPLIES_PER_DAY=20

# Globális óránkénti küldési korlát (az Instagram kb. 200/óra/fiók).
# Alapértelmezés: 180
# IG_MAX_SENDS_PER_HOUR=180
